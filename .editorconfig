root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,md,slnx,props,csproj}]
indent_size = 2

[*.cs]
max_line_length = 120
# `dotnet format` owns C# style; these rules keep edits aligned with it.
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[*.{sh,yml,yaml}]
# Container and CI tooling runs on Linux; CRLF in here is a bug.
end_of_line = lf

[*.md]
# Trailing double-space is a hard line break in Markdown; never strip it silently.
trim_trailing_whitespace = false
