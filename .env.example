# BookMarker deployment env — copy to .env and edit as needed. All values are optional.

# ---- image ----
# Defaults to the published image. Point this at a local tag to run your own build.
BOOKMARKER_IMAGE=ghcr.io/hyper-dragon/bookmarker:latest

# ---- capacity / limits ----
BOOKMARKER_MEMORY=9g
BOOKMARKER_PORT=8080
WORKERS=1
MAX_TIME_MS=3600000
MAX_UPLOAD_BYTES=536870912
BUSY_RETRY_AFTER_SECONDS=15
LOG_LEVEL=Information

# ---- LLM backend (OpenAI-compatible) ----
# Only used by requests that ask for llm=llmonly / llm=llmfallback.
# Leave OPENAI_BASE_URL/OPENAI_MODEL empty when this deployment never serves LLM requests.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=4
LLM_RETRY_WAIT_SECONDS=5

# ---- nothing to pre-download ----
# The model artifacts are baked into the image at build time, so a container never fetches
# them. There is no cache volume to seed and no first-run download to wait for.
