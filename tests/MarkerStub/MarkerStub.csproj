<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Named `marker` on purpose: it stands in for the marker CLI, selected with
         MARKER_BINARY. It is a test fixture and is never shipped in the image. -->
    <AssemblyName>marker</AssemblyName>
    <RootNamespace>MarkerStub</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
